# Copy this file to `.env` (which is git-ignored) and restart `npm run dev`.

# Enables the "More questions in this interview's style (AI)" helper on the practice page.
# Create a key at https://console.anthropic.com/ - it is only ever read by the local API server.
ANTHROPIC_API_KEY=

# Optional: which model the helper uses (default: claude-sonnet-5).
# PREPFLOW_AI_MODEL=claude-sonnet-5

# Optional, for development: return canned questions instead of calling the API.
# PREPFLOW_AI=stub

# Hosted database (Vercel + Turso). Leave both empty locally: the app then uses the SQLite file in server/data.
# TURSO_DATABASE_URL=libsql://prepflow-<your-name>.turso.io
# TURSO_AUTH_TOKEN=
