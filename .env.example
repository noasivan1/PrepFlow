# Copy this file to `.env` (which is git-ignored) and restart `npm run dev`.
# Never commit a real key: .env and every .env.* except this example are ignored.

# Answer checking on the practice page ("Check my answer") uses the Gemini Developer API.
# Create a key at https://aistudio.google.com/ - it is only ever read by the API server.
GEMINI_API_KEY=
# Optional: which Gemini model to use (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# Optional second provider. The question generator prefers it when set; answer checking
# falls back to it when GEMINI_API_KEY is missing.
# ANTHROPIC_API_KEY=
# PREPFLOW_AI_MODEL=claude-sonnet-5

# Development only: canned AI replies without any key (stub), or always failing (fail).
# PREPFLOW_AI=stub

# Answer evaluations allowed per user per hour (default 30).
# PREPFLOW_EVAL_HOURLY_LIMIT=30

# Hosted database (Vercel + Turso). Leave both empty locally: the app then uses the SQLite file in server/data.
# TURSO_DATABASE_URL=libsql://prepflow-<your-name>.turso.io
# TURSO_AUTH_TOKEN=
