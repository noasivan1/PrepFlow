{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.server.json" }
  ],
  // Vercel compiles api/index.ts (and the server files it imports) with THIS file as the base;
  // it never looks at the referenced configs. The server imports with explicit .ts extensions,
  // which that compile rewrites to .js only when allowImportingTsExtensions is on. The options
  // below mirror tsconfig.server.json for that purpose; `tsc -b` itself ignores them (no files).
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
